DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voiceagent"

# Auth & 2FA (Authenticator App)
API_KEY="dev-secret-key-change-me"
AUTH_EMAIL="admin@axiomra.ai"
AUTH_PASSWORD="Passw"
AUTH_JWT_SECRET="a-very-secret-jwt-key-with-min-32-chars"
TOTP_ISSUER="VoiceAgent"

# LLM
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# STT
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your-deepgram-key-here

# TTS
TTS_PROVIDER=openai

# Web search
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=your-brave-key-here

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# App
PORT=3000
UPLOAD_DIR=./uploads
MEMORY_TRIGGER_TURNS=10
SHORT_TERM_WINDOW=20
