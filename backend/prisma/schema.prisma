// This is your Prisma schema file for Voice Agent
// Database: PostgreSQL 16 + pgvector extension

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String   @map("system_prompt")
  enabledTools String[] @map("enabled_tools")
  llmProvider  String   @default("claude") @map("llm_provider")
  llmModel     String   @default("claude-sonnet-4-5") @map("llm_model")
  ttsVoice     String   @default("alloy") @map("tts_voice")
  ttsGender    String   @default("neutral") @map("tts_gender")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  conversations Conversation[]
  documents     Document[]
  memories      Memory[]

  @@map("agents")
}

model Conversation {
  id            String    @id @default(uuid())
  agentId       String    @map("agent_id")
  title         String?
  contextPrompt String?   @map("context_prompt")
  ttsVoice      String?   @map("tts_voice")
  ttsGender     String?   @map("tts_gender")
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // user | assistant | tool
  content        String
  toolName       String?  @map("tool_name")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], name: "idx_messages_conversation")
  @@map("messages")
}

model Document {
  id         String   @id @default(uuid())
  agentId    String   @map("agent_id")
  filename   String
  status     String   @default("processing") // processing | ready | failed
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  agent  Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@map("documents")
}

// document_chunks and memories use raw SQL for pgvector VECTOR columns
// Prisma doesn't support VECTOR type natively — we use $queryRaw / $executeRaw

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  // embedding VECTOR(1536) — created via raw migration SQL

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model Memory {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  // embedding VECTOR(1536) — created via raw migration SQL

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("memories")
}
