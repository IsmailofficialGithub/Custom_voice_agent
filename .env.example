# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voiceagent
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/voiceagent"

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=voiceagent:
SESSION_TTL_SEC=600
RAG_CACHE_TTL_SEC=600

# Rate Limiting Controls
VOICE_RATE_LIMIT_TURNS=30
VOICE_RATE_LIMIT_WINDOW_SEC=60

# Application Ports & Keys
API_KEY="dev-secret-key-change-me"
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=3001

# AI Providers & Keys
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_LANGUAGE=auto
TTS_PROVIDER=openai
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=your-brave-key-here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Voice Engine Settings (pipeline | realtime)
VOICE_ENGINE=pipeline
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Memory & Upload Settings
UPLOAD_DIR=./uploads
MEMORY_TRIGGER_TURNS=10
SHORT_TERM_WINDOW=20

# Frontend Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/voice
